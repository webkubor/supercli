{
  "name": "supercli",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "description": "Open-source CLI discovery and rankings, maintained through pull requests.",
  "license": "MIT",
  "repository": "https://github.com/webkubor/supercli",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "pnpm typecheck && node scripts/validate.mjs && pnpm test",
    "build": "pnpm check && vite build && node scripts/check-static.mjs && pnpm exec tsx scripts/check-hygiene.ts",
    "sync": "node scripts/sync.mjs",
    "og": "tsx scripts/generate-tool-cards.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "sync:usage": "node scripts/sync-usage.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-agent-eyes": "^0.15.1",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide": "^1.59.0"
  },
  "packageManager": "pnpm@12.4.1"
}
