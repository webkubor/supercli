{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "curator", "quote", "evidence"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "curator": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
      },
      "quote": {
        "type": "string",
        "minLength": 8
      },
      "evidence": {
        "type": "string",
        "pattern": "^https://github\\.com/webkubor/supercli/issues/[1-9]\\d*$"
      }
    }
  }
}
